{
  "name": "@acobb/firepower",
  "version": "1.5.1",
  "description": "powerful utils for firebase",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "author": "Adam Cobb <adam@cobb.engineer>",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "mkdir -p dist/esm && cp -r src/* dist/esm/",
    "build:cjs": "mkdir -p dist/cjs && cp -r src/* dist/cjs/ && node scripts/add-cjs.js",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.10.0",
    "firebase-admin": "^12.0.0",
    "firestore-jest-mock": "^0.24.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "firebase-admin": "^12.0.0"
  }
}
